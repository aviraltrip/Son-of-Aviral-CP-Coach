# LLM API Keys (Set at least one depending on your preferred provider)
OPENROUTER_API_KEY=your_openrouter_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model Selection Configuration
TUTOR_MODEL_NAME=gemini-1.5-pro
KEEPER_MODEL_NAME=gemini-1.5-flash
ANALYST_MODEL_NAME=gemini-1.5-flash

# Codeforces API Settings (Optional: only needed if using private/authenticated endpoints)
CODEFORCES_API_KEY=
CODEFORCES_API_SECRET=

# Database Configuration
DATABASE_PATH=cp_coach.db

# LangSmith Observability & Tracing (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=cp-coach
