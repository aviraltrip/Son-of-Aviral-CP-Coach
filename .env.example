# Operational Environment (development | production | testing)
ENVIRONMENT=development

# LLM Providers (Configure at least one)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here

# LLM Model Selection
TUTOR_MODEL_NAME=anthropic/claude-3.5-sonnet
KEEPER_MODEL_NAME=openai/gpt-4o-mini
ANALYST_MODEL_NAME=openai/gpt-4o-mini

# Database & Checkpoint Persistence
DATABASE_PATH=cp_coach.db
CHECKPOINTS_DB_PATH=checkpoints.db
CHECKPOINTS_PERSIST=true

# Sandbox Judge Backend (isolated_subprocess | judge0 | disabled)
JUDGE_BACKEND=isolated_subprocess
# JUDGE0_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_API_KEY=

# Authentication & Access Control (disabled | optional | required)
AUTH_MODE=optional
# APP_PASSKEY=your_secure_passkey_here
